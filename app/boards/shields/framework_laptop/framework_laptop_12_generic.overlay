 *
 * Unified ANSI + ISO matrix transform for the Framework Laptop 12 input deck.
 * 80 positions total. Positions that only exist on one physical layout are
 * declared but dormant on the other (no key wired ⇒ no scan event).
 */

#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,matrix-transform = &framework_laptop_12_generic_transform;
    };

    framework_laptop_12_generic_transform: framework_laptop_12_generic_transform {
        compatible = "zmk,matrix-transform";
        rows = <8>;
        columns = <18>;

        // (row, col)
        map = <
        // Row 0: Esc..Del (14 positions, shared)
        RC(1,1)  RC(0,2)  RC(3,2)  RC(2,2)  RC(1,2)  RC(4,4)  RC(2,4)  RC(1,4)  RC(2,11) RC(1,9)  RC(0,4)  RC(0,1)  RC(1,5)  RC(2,9)
        // Row 1: `..BSPC (14 positions, shared)
        RC(3,1)  RC(5,1)  RC(6,4)  RC(6,2)  RC(6,3)  RC(3,3)  RC(3,8)  RC(6,8)  RC(6,5)  RC(6,9)  RC(6,6)  RC(3,6)  RC(0,8)  RC(1,11)
        // Row 2: Tab..\ (14 positions; last slot RC(3,11) = BSLH is ANSI-only, dormant on ISO)
        RC(2,1)  RC(7,5)  RC(7,6)  RC(7,8)  RC(7,9)  RC(2,3)  RC(2,6)  RC(7,1)  RC(7,2)  RC(7,3)  RC(7,4)  RC(2,8)  RC(2,5)  RC(3,11)
        // Row 3: Caps..Enter (14 positions; slot 12 RC(6,17) = NUHS is ISO-only, dormant on ANSI)
        RC(6,15) RC(4,1)  RC(3,4)  RC(4,2)  RC(4,3)  RC(1,3)  RC(1,6)  RC(4,6)  RC(4,5)  RC(4,9)  RC(4,8)  RC(1,8)  RC(6,17) RC(4,11)
        // Row 4: LShift..RShift (13 positions; slot 1 RC(7,17) = NUBS is ISO-only, dormant on ANSI)
        RC(5,7)  RC(7,17) RC(6,1)  RC(5,8)  RC(5,5)  RC(5,9)  RC(0,3)  RC(0,5)  RC(5,11) RC(5,2)  RC(5,3)  RC(5,4)  RC(7,7)
        // Row 5: LCtrl..Right (10 positions, shared)
        RC(1,14) RC(0,16) RC(3,0)  RC(6,13)                   RC(5,6)                    RC(0,10) RC(3,14) RC(7,12) RC(7,11) RC(6,12)
        // Row 6: Down (1 position, shared)
                                                                                                                    RC(6,11)
        >;
    };
};
