/*
 * Shield overlay for Dahlia Touchpad Module.
 * Defines matrix transform and I2C HID target.
 * The kscan matrix (with variant-specific pin assignments) is
 * defined in each board's DTS file.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &dahlia_transform;
    };

    dahlia_transform: dahlia_transform {
        compatible = "zmk,matrix-transform";
        rows = <8>;
        columns = <18>;

        // Row = KSI number, Col = KSO number
        map = <
        //  Esc      F1       F2       F3       F4       F5       F6       F7       F8       F9       F10      F11      F12      Del
        RC(1,1)  RC(0,2)  RC(3,2)  RC(2,2)  RC(1,2)  RC(4,4)  RC(2,4)  RC(1,4)  RC(2,11) RC(1,9)  RC(0,4)  RC(0,1)  RC(1,5)  RC(2,9)
        //  `        1        2        3        4        5        6        7        8        9        0        -        =        Bksp
        RC(3,1)  RC(5,1)  RC(6,4)  RC(6,2)  RC(6,3)  RC(3,3)  RC(3,8)  RC(6,8)  RC(6,5)  RC(6,9)  RC(6,6)  RC(3,6)  RC(0,8)  RC(1,11)
        //  Tab      Q        W        E        R        T        Y        U        I        O        P        [        ]        Backslash
        RC(2,1)  RC(7,5)  RC(7,6)  RC(7,8)  RC(7,9)  RC(2,3)  RC(2,6)  RC(7,1)  RC(7,2)  RC(7,3)  RC(7,4)  RC(2,8)  RC(2,5)  RC(3,11)
        //  Caps     A        S        D        F        G        H        J        K        L        ;        '                 Enter
        RC(6,15) RC(4,1)  RC(3,4)  RC(4,2)  RC(4,3)  RC(1,3)  RC(1,6)  RC(4,6)  RC(4,5)  RC(4,9)  RC(4,8)  RC(1,8)           RC(4,11)
        //  LShift            Z        X        C        V        B        N        M        ,        .        /        RShift
        RC(5,7)           RC(6,1)  RC(5,8)  RC(5,5)  RC(5,9)  RC(0,3)  RC(0,5)  RC(5,11) RC(5,2)  RC(5,3)  RC(5,4)  RC(7,7)
        //  LCtrl    Fn       Super    LAlt                      Space                      RAlt     RCtrl    Left     Up       Right
        RC(1,14) RC(0,16) RC(3,0)  RC(6,13)                   RC(5,6)                    RC(0,10) RC(3,14) RC(7,12) RC(7,11) RC(6,12)
        //                                                                                                            Down
                                                                                                                    RC(6,11)
        >;
    };
};

/*
 * I2C HID target at address 0x15.
 * IRQ output on PA12 (active-low, open-drain).
 */
&i2c1 {
    i2c_hid: hid-target@15 {
        compatible = "zephyr,i2c-target-hid";
        reg = <0x15>;
        irq-gpios = <&gpioa 12 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
        vid = <0x32AC>;
        pid = <0x0038>;
        max-input-length = <11>;
        max-output-length = <4>;
        report-desc-length = <76>;
    };
};
