#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include "framework13-layouts.dtsi"

/ {
    matrix_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <8>;
        columns = <16>;

        // (row, col)
        map = <
        RC(7,4)  RC(3,5)  RC(2,5)  RC(6,3)  RC(3,4)  RC(4,10) RC(3,10) RC(2,10) RC(1,15) RC(3,11) RC(4,8)  RC(6,7)  RC(3,13) RC(0,1)
        RC(4,2)  RC(5,2)  RC(5,4)  RC(5,3)  RC(5,5)  RC(4,5)  RC(4,6)  RC(5,6)  RC(5,10) RC(5,7)  RC(4,13) RC(2,13) RC(4,14) RC(5,13)
        RC(3,2)  RC(0,2)  RC(6,4)  RC(2,4)  RC(6,5)  RC(3,6)  RC(3,7)  RC(6,6)  RC(6,10) RC(3,8)  RC(5,12) RC(6,12) RC(6,13) RC(2,8)
        RC(4,4)  RC(7,2)  RC(4,5)  RC(7,13) RC(7,5)  RC(2,6)  RC(2,7)  RC(7,6)  RC(7,10) RC(7,7)  RC(7,12) RC(0,14) RC(1,14)
        RC(1,9)           RC(1,5)  RC(0,5)  RC(0,0)  RC(0,6)  RC(1,6)  RC(1,7)  RC(0,7)  RC(0,10) RC(0,8)  RC(0,13) RC(0,9)
        RC(1,12) RC(2,2)  RC(3,1)  RC(1,3)                    RC(1,4)                    RC(0,3)  RC(0,12) RC(6,11) RC(1,13) RC(2,15)
                                                                                                                    RC(1,8)
        >;
    };

    kscan0: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";
        debounce-press-ms = <1>;
        debounce-release-ms = <5>;
        poll-period-ms = <1>;

        col-gpios
        = <&arduino_header  0 GPIO_ACTIVE_HIGH> // KSO0
        , <&arduino_header  1 GPIO_ACTIVE_HIGH> // KSO1
        , <&arduino_header  2 GPIO_ACTIVE_HIGH> // KSO2
        , <&arduino_header  3 GPIO_ACTIVE_HIGH> // KSO3
        , <&arduino_header  4 GPIO_ACTIVE_HIGH> // KSO4
        , <&arduino_header  5 GPIO_ACTIVE_HIGH> // KSO5
        , <&arduino_header  6 GPIO_ACTIVE_HIGH> // KSO6
        , <&arduino_header  7 GPIO_ACTIVE_HIGH> // KSO7
        , <&arduino_header  8 GPIO_ACTIVE_HIGH> // KSO8
        , <&arduino_header  9 GPIO_ACTIVE_HIGH> // KSO9
        , <&arduino_header 10 GPIO_ACTIVE_HIGH> // KS10
        , <&arduino_header 11 GPIO_ACTIVE_HIGH> // KS11
        , <&arduino_header 12 GPIO_ACTIVE_HIGH> // KS12
        , <&arduino_header 13 GPIO_ACTIVE_HIGH> // KS13
        , <&arduino_header 14 GPIO_ACTIVE_HIGH> // KS14
        , <&arduino_header 15 GPIO_ACTIVE_HIGH> // KS15
        ;

        row-gpios
        = <&arduino_header 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI0
        , <&arduino_header 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI1
        , <&arduino_header 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI2
        , <&arduino_header 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI3
        , <&arduino_header 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI4
        , <&arduino_header 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI5
        , <&gpioc           2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI6
        , <&gpioc           3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // KSI7
        ;
    };

};

&matrix_physical_layout {
    kscan = <&kscan0>;
    transform = <&matrix_transform>;
};
