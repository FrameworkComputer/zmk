# Generate dahlia_git_version.h with the current git hash and dirty flag.
# Run at build time; only touches the output when the content changes.

execute_process(COMMAND git -C ${REPO} rev-parse HEAD
                OUTPUT_VARIABLE hash
                OUTPUT_STRIP_TRAILING_WHITESPACE
                RESULT_VARIABLE git_err
                ERROR_QUIET)
execute_process(COMMAND git -C ${REPO} status --porcelain -uno
                OUTPUT_VARIABLE dirty ERROR_QUIET)

if(git_err OR "${hash}" STREQUAL "")
    set(hash "0000000000000000")
endif()

string(SUBSTRING "${hash}" 0 16 hash16)
set(bytes "")
foreach(i RANGE 0 14 2)
    string(SUBSTRING "${hash16}" ${i} 2 b)
    string(APPEND bytes "0x${b}, ")
endforeach()

if(dirty)
    set(is_dirty 1)
else()
    set(is_dirty 0)
endif()

file(WRITE ${OUT}.tmp
"/* Generated by git_version.cmake -- do not edit. */
#define DAHLIA_GIT_HASH_BYTES { ${bytes}}
#define DAHLIA_GIT_DIRTY ${is_dirty}
")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUT}.tmp ${OUT})
file(REMOVE ${OUT}.tmp)
